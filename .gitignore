# ---- 本地环境（conda prefix / pip / torch 扩展缓存，勿入库）----
.conda/
.cache/
*.egg-info/

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- 构建产物 ----
build/
dist/
*.so

# ---- 本机私有配置（覆盖 configs/*.yaml，不入库）----
configs/local.yaml

# ---- 数据与权重（体积大 / 涉许可，勿入库）----
data/*
!data/.gitkeep
output/*
!output/.gitkeep

# ---- 模型（单个 .ply 约 60MB，不入库；照 README 从 RGBAvatar 复制）----
models/*
!models/.gitkeep

# ---- vendored 源码中的非必要内容 ----
submodules/diff-gaussian-rasterization/third_party/glm/manual.md
submodules/*/.git/
submodules/*/build/
submodules/*/samples/data/

# ---- 组会周报（内部汇报，不入库）----
docs/周报/

# 数据集
datasets/*
!datasets/.gitkeep